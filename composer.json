{
    "name": "qbdigitalsoftware/composer-vendor-checker",
    "description": "Composer plugin to check installed packages for available updates",
    "type": "composer-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Carl Simpson",
            "email": "carl@qbdigital.co.uk"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^6.5|^7.0",
        "ext-json": "*",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0",
        "composer/composer": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "QBDigital\\VendorChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QBDigital\\VendorChecker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "QBDigital\\VendorChecker\\ComposerPlugin"
    },
    "config": {
        "allow-plugins": {
            "qbdigitalsoftware/composer-vendor-checker": true
        }
    }
}
