# Exclude development and documentation files from Packagist zipball.
# These files are useful for contributors but not needed by end users.

/tests              export-ignore
/docs               export-ignore
/examples           export-ignore
/phpunit.xml        export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
/CODE_OF_CONDUCT.md export-ignore
/run-check.php      export-ignore
